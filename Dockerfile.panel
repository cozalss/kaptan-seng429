# syntax=docker/dockerfile:1.7
# KAPtan panel (kaptan-panel, Next.js) in http mode, with the landing (kaptan-landing) at "/".
# Build context = the repo root (the panel's prebuild step builds ../kaptan-landing into public/):
#   docker build -f Dockerfile.panel -t kaptan-panel:local --build-arg KAPTAN_API_ORIGIN=http://api:8000 .
# /api/v1/* is rewritten to KAPTAN_API_ORIGIN; Next fixes rewrites at build time, so it is a build arg.
# No secret is baked in (Dockerfile.panel.dockerignore drops every .env).

ARG NODE_IMAGE=node:24-bookworm-slim

FROM ${NODE_IMAGE} AS build
ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /src
COPY kaptan-landing/package.json kaptan-landing/package-lock.json kaptan-landing/
RUN --mount=type=cache,target=/root/.npm \
    cd kaptan-landing && npm ci --include=dev --no-audit --no-fund
COPY kaptan-panel/package.json kaptan-panel/package-lock.json kaptan-panel/.npmrc kaptan-panel/
RUN --mount=type=cache,target=/root/.npm \
    cd kaptan-panel && npm ci --include=dev --no-audit --no-fund
COPY kaptan-landing kaptan-landing
COPY kaptan-panel kaptan-panel
ARG KAPTAN_API_ORIGIN=http://api:8000
ENV NEXT_PUBLIC_API_MODE=http \
    KAPTAN_API_ORIGIN=${KAPTAN_API_ORIGIN}
RUN cd kaptan-panel && npm run build

FROM ${NODE_IMAGE} AS runtime
ARG KAPTAN_API_ORIGIN=http://api:8000
LABEL org.opencontainers.image.title="kaptan-panel" \
      org.opencontainers.image.source="https://github.com/cozalss/kaptan-seng429"
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    NEXT_PUBLIC_API_MODE=http \
    KAPTAN_API_ORIGIN=${KAPTAN_API_ORIGIN}
WORKDIR /app
COPY --from=build --chown=node:node /src/kaptan-panel /app
USER node
EXPOSE 3100
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
    CMD ["node", "-e", "fetch('http://127.0.0.1:3100/login').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
CMD ["node_modules/.bin/next", "start", "-p", "3100", "-H", "0.0.0.0"]
