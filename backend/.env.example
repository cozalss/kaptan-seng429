# KAPtan backend environment. Copy to backend/.env and fill in. Never commit .env.
# The compose file (docker-compose.yml) and the API (settings.py) both read this file.

# dev | test | prod. In dev only, JWT_SECRET and PASSPHRASE_HASH fall back to safe dev defaults.
KAPTAN_ENV=dev

# ── docker compose (Postgres 16 + pgvector, Redis 7) ─────────────────────
POSTGRES_DB=kaptan
POSTGRES_USER=kaptan_owner
POSTGRES_PASSWORD=<choose-a-password>
KAPTAN_APP_PASSWORD=<choose-another-password>
REDIS_PASSWORD=<choose-a-redis-password>

# ── API ──────────────────────────────────────────────────────────────────
# The API connects as kaptan_app (audit_log: INSERT/SELECT only).
DATABASE_URL=postgresql://kaptan_app:<KAPTAN_APP_PASSWORD>@127.0.0.1:5432/kaptan
# Owner connection: migrations, seed, and the demo-only reset/tamper (DEMO_MODE=true).
DATABASE_OWNER_URL=postgresql://kaptan_owner:<POSTGRES_PASSWORD>@127.0.0.1:5432/kaptan
# Integration tests migrate and seed this database (created by db/init/00_roles.sh).
TEST_DATABASE_URL=postgresql://kaptan_app:<KAPTAN_APP_PASSWORD>@127.0.0.1:5432/kaptan_test
TEST_DATABASE_OWNER_URL=postgresql://kaptan_owner:<POSTGRES_PASSWORD>@127.0.0.1:5432/kaptan_test
REDIS_URL=redis://:<REDIS_PASSWORD>@127.0.0.1:6379/0

# HS256 signing key for access tokens, >= 32 bytes (python -c "import secrets;print(secrets.token_urlsafe(48))").
JWT_SECRET=<random-48-bytes>
# argon2id hash of the single login passphrase: uv run python scripts/hash_passphrase.py
# (dev without a value: the demo passphrase "kaptan2026").
PASSPHRASE_HASH=

# Demo: /demo/* endpoints, fixture injection, the demo clock (11.01.2027 13:40 Istanbul).
DEMO_MODE=true
# replay = recorded LLM outputs (M1, no API keys); live = real providers (M2).
LLM_MODE=replay
# Live providers (M2). Leave empty to skip one. Never commit real keys (.env is gitignored).
# Gemini: https://aistudio.google.com/apikey · DeepSeek: https://platform.deepseek.com/api_keys · Groq: https://console.groq.com/keys
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
# Daily hard caps per provider (UTC day); model IDs are in config/models.yaml. See README "Live LLM mode".
LLM_CAP_GEMINI_RPD=400
LLM_CAP_GROQ_RPD=900
LLM_CAP_GROQ_TPD=180000
LLM_CAP_GUARD_RPD=14000
LLM_CAP_DEEPSEEK_RPD=200
LLM_CAP_DEEPSEEK_USD=0.50

# Live KAP ingestion (M2): the worker `python -m kaptan.workers.ingest_worker` runs only with KAP_LIVE=true.
# Polite limits: in-session poll >= 30 s, >= 2 s between any two KAP requests. See README "KAP ingestion".
KAP_LIVE=false
# KAP_POLL_SESSION_S=30
# KAP_MIN_INTERVAL_S=2

# Agent feed (M2): `python -m kaptan.workers.agent_worker` turns new KAP rows into agent runs (KAP_LIVE=true,
# DEMO_MODE=false). At most this many LLM-spending runs per rolling hour. See README "Agent feed".
# AGENT_MAX_RUNS_PER_HOUR=6
# LangGraph checkpointer: memory (default) | postgres (graph threads survive restarts; migration 0010).
CHECKPOINTER=memory

# Prices (M2): `python -m kaptan.prices.backfill` fills core.prices_daily (İş Yatırım raw + Yahoo adjusted).
# PRICES_LIVE=true marks positions with those rows instead of the demo's replay marks. See README "Prices".
PRICES_LIVE=false
# PRICES_MIN_INTERVAL_S=2

# Refresh cookie. true -> "__Host-kaptan_rt; Secure" (browsers accept Secure on http://localhost).
# false -> "kaptan_rt" without Secure, only for plain-http hosts other than localhost.
COOKIE_SECURE=true
# Origins allowed to call /auth/refresh (the panel). Empty = no Origin check.
ALLOWED_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
