{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "kind": {
   "type": "string",
   "enum": [
    "E1",
    "E2",
    "E3",
    "E4"
   ]
  },
  "label_tr": {
   "type": "string"
  },
  "n": {
   "type": "integer",
   "minimum": 0,
   "maximum": 9007199254740991
  },
  "hit_rate": {
   "anyOf": [
    {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    {
     "type": "null"
    }
   ]
  },
  "mean_net": {
   "type": [
    "number",
    "null"
   ]
  },
  "median_net": {
   "type": [
    "number",
    "null"
   ]
  },
  "horizon_days": {
   "type": "integer",
   "minimum": 1,
   "maximum": 9007199254740991
  },
  "calibration": {
   "type": "object",
   "properties": {
    "n_matured": {
     "type": "integer",
     "minimum": 0,
     "maximum": 9007199254740991
    },
    "needed": {
     "type": "integer",
     "minimum": 1,
     "maximum": 9007199254740991
    },
    "slope": {
     "type": [
      "number",
      "null"
     ]
    },
    "bias_bps": {
     "type": [
      "number",
      "null"
     ]
    },
    "factor": {
     "type": "number"
    },
    "active": {
     "type": "boolean"
    }
   },
   "required": [
    "n_matured",
    "needed",
    "slope",
    "bias_bps",
    "factor",
    "active"
   ],
   "additionalProperties": false
  }
 },
 "required": [
  "kind",
  "label_tr",
  "n",
  "hit_rate",
  "mean_net",
  "median_net",
  "horizon_days",
  "calibration"
 ],
 "additionalProperties": false
}
