{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "proposal_id": {
   "type": "string"
  },
  "run_id": {
   "type": "string"
  },
  "strategy_version": {
   "type": "string"
  },
  "rules_hash": {
   "type": "string"
  },
  "prompt_manifest_hash": {
   "type": "string"
  },
  "disclosure_index": {
   "type": "integer",
   "exclusiveMinimum": 0,
   "maximum": 9007199254740991
  },
  "ticker": {
   "type": "string",
   "pattern": "^[A-Z0-9]{3,6}$"
  },
  "venue": {
   "type": "string",
   "const": "BIST"
  },
  "side": {
   "type": "string",
   "enum": [
    "buy",
    "sell"
   ]
  },
  "event_type": {
   "anyOf": [
    {
     "type": "string",
     "enum": [
      "E1",
      "E2",
      "E3",
      "E4"
     ]
    },
    {
     "type": "string",
     "const": "EXIT"
    }
   ]
  },
  "rule_ids": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "entry": {
   "type": "string",
   "enum": [
    "next_open_auction",
    "intraday_limit"
   ]
  },
  "limit_price": {
   "type": "number",
   "exclusiveMinimum": 0
  },
  "ref_price": {
   "type": "number",
   "exclusiveMinimum": 0
  },
  "ref_price_at": {
   "type": "string",
   "format": "date-time",
   "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
  },
  "requested_notional_try": {
   "type": "number",
   "minimum": 0
  },
  "requested_qty": {
   "type": "integer",
   "minimum": 0,
   "maximum": 9007199254740991
  },
  "stop_price": {
   "type": "number",
   "exclusiveMinimum": 0
  },
  "holding_days_min": {
   "type": "integer",
   "exclusiveMinimum": 0,
   "maximum": 9007199254740991
  },
  "holding_days_max": {
   "type": "integer",
   "exclusiveMinimum": 0,
   "maximum": 9007199254740991
  },
  "exit_rules": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "expected_edge_bps": {
   "type": "number"
  },
  "est_cost_bps": {
   "type": "number",
   "minimum": 0
  },
  "multipliers": {
   "type": "object",
   "properties": {
    "evidence": {
     "type": "number"
    },
    "skeptic": {
     "type": "number"
    },
    "leakage": {
     "type": "number"
    },
    "regime": {
     "type": "number"
    }
   },
   "required": [
    "evidence",
    "skeptic",
    "leakage",
    "regime"
   ],
   "additionalProperties": false
  },
  "confidence": {
   "type": "number",
   "minimum": 0,
   "maximum": 1
  },
  "evidence_card_id": {
   "type": [
    "string",
    "null"
   ]
  },
  "evidence_ids": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "retrieved_ids": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "escalate_required": {
   "type": "boolean"
  },
  "degraded": {
   "type": "boolean"
  }
 },
 "required": [
  "proposal_id",
  "run_id",
  "strategy_version",
  "rules_hash",
  "prompt_manifest_hash",
  "disclosure_index",
  "ticker",
  "venue",
  "side",
  "event_type",
  "rule_ids",
  "entry",
  "limit_price",
  "ref_price",
  "ref_price_at",
  "requested_notional_try",
  "requested_qty",
  "stop_price",
  "holding_days_min",
  "holding_days_max",
  "exit_rules",
  "expected_edge_bps",
  "est_cost_bps",
  "multipliers",
  "confidence",
  "evidence_card_id",
  "evidence_ids",
  "retrieved_ids",
  "escalate_required",
  "degraded"
 ],
 "additionalProperties": false
}
