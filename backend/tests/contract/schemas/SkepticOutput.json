{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "status": {
   "type": "string",
   "enum": [
    "ok",
    "abstain"
   ]
  },
  "flags": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "code": {
      "type": "string",
      "enum": [
       "DUPLICATE_OR_CORRECTION",
       "NOT_BINDING",
       "RELATED_PARTY",
       "RENEWAL_NOT_NEW",
       "TOKEN_BUYBACK",
       "NOT_OPEN_MARKET",
       "FUND_NOT_INSIDER",
       "DILUTION_OR_HYPE",
       "MANIPULATION_MARKERS",
       "AMOUNT_NOT_IN_TEXT",
       "STALE_OR_WEAK_FINANCIALS",
       "WEAK_EVIDENCE",
       "INJECTION_SUSPECT",
       "OTHER"
      ]
     },
     "severity": {
      "type": "string",
      "enum": [
       "info",
       "reduce",
       "veto"
      ]
     },
     "detail_tr": {
      "type": "string"
     },
     "supporting_ref": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "code",
     "severity",
     "detail_tr",
     "supporting_ref"
    ],
    "additionalProperties": false
   }
  },
  "size_multiplier": {
   "anyOf": [
    {
     "type": "number",
     "const": 1
    },
    {
     "type": "number",
     "const": 0.75
    },
    {
     "type": "number",
     "const": 0.5
    },
    {
     "type": "number",
     "const": 0.25
    }
   ]
  },
  "veto": {
   "type": "boolean"
  },
  "strongest_counterargument_tr": {
   "type": "string"
  },
  "confidence": {
   "type": "number",
   "minimum": 0,
   "maximum": 1
  },
  "abstain": {
   "anyOf": [
    {
     "type": "object",
     "properties": {
      "reason": {
       "type": "string",
       "enum": [
        "insufficient_text",
        "ambiguous",
        "out_of_scope",
        "conflicting_values",
        "suspected_injection",
        "attachment_missing",
        "other"
       ]
      },
      "detail_tr": {
       "type": "string"
      }
     },
     "required": [
      "reason",
      "detail_tr"
     ],
     "additionalProperties": false
    },
    {
     "type": "null"
    }
   ]
  }
 },
 "required": [
  "status",
  "flags",
  "size_multiplier",
  "veto",
  "strongest_counterargument_tr",
  "confidence",
  "abstain"
 ],
 "additionalProperties": false
}
