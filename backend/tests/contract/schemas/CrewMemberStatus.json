{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "agent": {
   "type": "string",
   "enum": [
    "classifier",
    "reader",
    "materiality",
    "evidence",
    "skeptic",
    "compliance",
    "rule_engine",
    "risk_gate"
   ]
  },
  "activity": {
   "type": "string",
   "enum": [
    "working",
    "waiting",
    "idle",
    "hold",
    "degraded"
   ]
  },
  "activity_tr": {
   "type": "string"
  },
  "current_run_id": {
   "type": [
    "string",
    "null"
   ]
  },
  "model_chain": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "provider": {
      "type": "string"
     },
     "model_id": {
      "type": "string"
     },
     "role": {
      "type": "string",
      "enum": [
       "primary",
       "fallback",
       "local",
       "hold"
      ]
     }
    },
    "required": [
     "provider",
     "model_id",
     "role"
    ],
    "additionalProperties": false
   }
  },
  "active_model": {
   "type": [
    "string",
    "null"
   ]
  },
  "quota": {
   "anyOf": [
    {
     "type": "object",
     "properties": {
      "provider": {
       "type": "string"
      },
      "used": {
       "type": "integer",
       "minimum": 0,
       "maximum": 9007199254740991
      },
      "limit": {
       "type": "integer",
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991
      }
     },
     "required": [
      "provider",
      "used",
      "limit"
     ],
     "additionalProperties": false
    },
    {
     "type": "null"
    }
   ]
  },
  "calls_today": {
   "type": "integer",
   "minimum": 0,
   "maximum": 9007199254740991
  },
  "tokens_today": {
   "type": "integer",
   "minimum": 0,
   "maximum": 9007199254740991
  },
  "latency_p50_ms": {
   "anyOf": [
    {
     "type": "integer",
     "minimum": 0,
     "maximum": 9007199254740991
    },
    {
     "type": "null"
    }
   ]
  },
  "latency_p95_ms": {
   "anyOf": [
    {
     "type": "integer",
     "minimum": 0,
     "maximum": 9007199254740991
    },
    {
     "type": "null"
    }
   ]
  },
  "accuracy": {
   "anyOf": [
    {
     "type": "object",
     "properties": {
      "metric_tr": {
       "type": "string"
      },
      "value": {
       "type": "number"
      },
      "target": {
       "type": [
        "number",
        "null"
       ]
      },
      "is_sample": {
       "type": "boolean"
      }
     },
     "required": [
      "metric_tr",
      "value",
      "target",
      "is_sample"
     ],
     "additionalProperties": false
    },
    {
     "type": "null"
    }
   ]
  },
  "prompt": {
   "anyOf": [
    {
     "type": "object",
     "properties": {
      "prompt_id": {
       "type": "string"
      },
      "version": {
       "type": "string"
      },
      "sha256": {
       "type": "string"
      }
     },
     "required": [
      "prompt_id",
      "version",
      "sha256"
     ],
     "additionalProperties": false
    },
    {
     "type": "null"
    }
   ]
  },
  "manifest_hash": {
   "type": "string"
  },
  "recent": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "run_id": {
      "type": "string"
     },
     "ticker": {
      "type": "string"
     },
     "at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
     },
     "status": {
      "type": "string",
      "enum": [
       "done",
       "skipped",
       "failed",
       "waiting",
       "running"
      ]
     },
     "summary_tr": {
      "type": "string"
     },
     "latency_ms": {
      "anyOf": [
       {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
       },
       {
        "type": "null"
       }
      ]
     },
     "tokens_in": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
     },
     "tokens_out": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
     },
     "model_id": {
      "type": [
       "string",
       "null"
      ]
     },
     "cached": {
      "type": "boolean"
     },
     "is_fixture": {
      "type": "boolean"
     }
    },
    "required": [
     "run_id",
     "ticker",
     "at",
     "status",
     "summary_tr",
     "latency_ms",
     "tokens_in",
     "tokens_out",
     "model_id",
     "cached",
     "is_fixture"
    ],
    "additionalProperties": false
   }
  }
 },
 "required": [
  "agent",
  "activity",
  "activity_tr",
  "current_run_id",
  "model_chain",
  "active_model",
  "quota",
  "calls_today",
  "tokens_today",
  "latency_p50_ms",
  "latency_p95_ms",
  "accuracy",
  "prompt",
  "manifest_hash",
  "recent"
 ],
 "additionalProperties": false
}
