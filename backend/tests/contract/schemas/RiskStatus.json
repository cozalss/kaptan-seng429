{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "daily_pnl_pct": {
   "type": "number"
  },
  "drawdown_pct": {
   "type": "number",
   "maximum": 0
  },
  "peak_equity": {
   "type": "number",
   "minimum": 0
  },
  "equity": {
   "type": "number",
   "minimum": 0
  },
  "regime": {
   "type": "string",
   "enum": [
    "normal",
    "crisis"
   ]
  },
  "live_armed": {
   "type": "boolean"
  },
  "quota": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "provider": {
      "type": "string"
     },
     "used": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
     },
     "limit": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
     }
    },
    "required": [
     "provider",
     "used",
     "limit"
    ],
    "additionalProperties": false
   }
  },
  "as_of": {
   "type": "string",
   "format": "date-time",
   "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
  }
 },
 "required": [
  "daily_pnl_pct",
  "drawdown_pct",
  "peak_equity",
  "equity",
  "regime",
  "live_armed",
  "quota",
  "as_of"
 ],
 "additionalProperties": false
}
