{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "ticker": {
   "type": "string",
   "pattern": "^[A-Z0-9]{3,6}$"
  },
  "company_name": {
   "type": "string"
  },
  "qty": {
   "type": "integer",
   "exclusiveMinimum": 0,
   "maximum": 9007199254740991
  },
  "avg_cost": {
   "type": "number",
   "exclusiveMinimum": 0
  },
  "last_price": {
   "type": "number",
   "exclusiveMinimum": 0
  },
  "opened_at": {
   "type": "string",
   "format": "date-time",
   "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
  },
  "planned_exit_date": {
   "type": "string",
   "format": "date",
   "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
  },
  "holding_days": {
   "type": "integer",
   "minimum": 0,
   "maximum": 9007199254740991
  },
  "source_proposal": {
   "type": "string"
  },
  "run_id": {
   "type": "string"
  },
  "event_type": {
   "type": "string",
   "enum": [
    "E1",
    "E2",
    "E3",
    "E4"
   ]
  },
  "strategy_version": {
   "type": "string"
  },
  "unrealized_pnl": {
   "type": "number"
  },
  "realized_pnl": {
   "type": "number"
  },
  "managed_by_exit_rule": {
   "type": "boolean"
  },
  "book": {
   "type": "string",
   "enum": [
    "paper",
    "personal"
   ]
  }
 },
 "required": [
  "ticker",
  "company_name",
  "qty",
  "avg_cost",
  "last_price",
  "opened_at",
  "planned_exit_date",
  "holding_days",
  "source_proposal",
  "run_id",
  "event_type",
  "strategy_version",
  "unrealized_pnl",
  "realized_pnl",
  "managed_by_exit_rule",
  "book"
 ],
 "additionalProperties": false
}
