{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "trade_date": {
   "type": "string",
   "format": "date",
   "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
  },
  "nominal_tl": {
   "type": "number",
   "minimum": 0
  },
  "capital_pct": {
   "anyOf": [
    {
     "type": "number",
     "minimum": 0
    },
    {
     "type": "null"
    }
   ]
  },
  "price_tl": {
   "anyOf": [
    {
     "type": "number",
     "exclusiveMinimum": 0
    },
    {
     "type": "null"
    }
   ]
  },
  "price_raw": {
   "type": "string"
  },
  "prior_nominal_in_program_tl": {
   "anyOf": [
    {
     "type": "number",
     "minimum": 0
    },
    {
     "type": "null"
    }
   ]
  }
 },
 "required": [
  "trade_date",
  "nominal_tl",
  "capital_pct",
  "price_tl",
  "price_raw",
  "prior_nominal_in_program_tl"
 ],
 "additionalProperties": false
}
