{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "period": {
   "type": "string",
   "enum": [
    "1m",
    "3m",
    "1y",
    "all"
   ]
  },
  "points": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "d": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
     },
     "close": {
      "type": "number"
     }
    },
    "required": [
     "d",
     "close"
    ],
    "additionalProperties": false
   }
  },
  "last_close": {
   "type": [
    "number",
    "null"
   ]
  },
  "last_day": {
   "anyOf": [
    {
     "type": "string",
     "format": "date",
     "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    {
     "type": "null"
    }
   ]
  },
  "change_pct": {
   "type": [
    "number",
    "null"
   ]
  }
 },
 "required": [
  "period",
  "points",
  "last_close",
  "last_day",
  "change_pct"
 ],
 "additionalProperties": false
}
