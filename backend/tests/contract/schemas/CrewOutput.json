{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "run_id": {
   "type": "string"
  },
  "ticker": {
   "type": "string"
  },
  "at": {
   "type": "string",
   "format": "date-time",
   "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
  },
  "status": {
   "type": "string",
   "enum": [
    "done",
    "skipped",
    "failed",
    "waiting",
    "running"
   ]
  },
  "summary_tr": {
   "type": "string"
  },
  "latency_ms": {
   "anyOf": [
    {
     "type": "integer",
     "minimum": 0,
     "maximum": 9007199254740991
    },
    {
     "type": "null"
    }
   ]
  },
  "tokens_in": {
   "type": "integer",
   "minimum": 0,
   "maximum": 9007199254740991
  },
  "tokens_out": {
   "type": "integer",
   "minimum": 0,
   "maximum": 9007199254740991
  },
  "model_id": {
   "type": [
    "string",
    "null"
   ]
  },
  "cached": {
   "type": "boolean"
  },
  "is_fixture": {
   "type": "boolean"
  }
 },
 "required": [
  "run_id",
  "ticker",
  "at",
  "status",
  "summary_tr",
  "latency_ms",
  "tokens_in",
  "tokens_out",
  "model_id",
  "cached",
  "is_fixture"
 ],
 "additionalProperties": false
}
