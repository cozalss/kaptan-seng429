{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "status": {
   "type": "string",
   "enum": [
    "ok",
    "abstain"
   ]
  },
  "event_type": {
   "type": "string",
   "enum": [
    "E1",
    "E2",
    "E3",
    "E4"
   ]
  },
  "denominator_kind": {
   "type": "string",
   "enum": [
    "annual_revenue",
    "market_cap",
    "paid_in_capital",
    "free_float_mcap",
    "none"
   ]
  },
  "denominator": {
   "anyOf": [
    {
     "type": "object",
     "properties": {
      "name": {
       "type": "string"
      },
      "value": {
       "type": "number"
      },
      "ref_id": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "value",
      "ref_id"
     ],
     "additionalProperties": false
    },
    {
     "type": "null"
    }
   ]
  },
  "revenue_available_at_as_of": {
   "type": "boolean"
  },
  "market_cap": {
   "anyOf": [
    {
     "type": "object",
     "properties": {
      "name": {
       "type": "string"
      },
      "value": {
       "type": "number"
      },
      "ref_id": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "value",
      "ref_id"
     ],
     "additionalProperties": false
    },
    {
     "type": "null"
    }
   ]
  },
  "fx_rates": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "name": {
      "type": "string"
     },
     "value": {
      "type": "number"
     },
     "ref_id": {
      "type": "string"
     }
    },
    "required": [
     "name",
     "value",
     "ref_id"
    ],
    "additionalProperties": false
   }
  },
  "trade_day_close": {
   "anyOf": [
    {
     "type": "object",
     "properties": {
      "name": {
       "type": "string"
      },
      "value": {
       "type": "number"
      },
      "ref_id": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "value",
      "ref_id"
     ],
     "additionalProperties": false
    },
    {
     "type": "null"
    }
   ]
  },
  "secondary": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "name": {
      "type": "string"
     },
     "value": {
      "type": "number"
     },
     "ref_id": {
      "type": "string"
     }
    },
    "required": [
     "name",
     "value",
     "ref_id"
    ],
    "additionalProperties": false
   }
  },
  "e4_lines": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "name": {
      "type": "string"
     },
     "value": {
      "type": "number"
     },
     "ref_id": {
      "type": "string"
     }
    },
    "required": [
     "name",
     "value",
     "ref_id"
    ],
    "additionalProperties": false
   }
  },
  "financials_period_end": {
   "anyOf": [
    {
     "type": "string",
     "format": "date",
     "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    {
     "type": "null"
    }
   ]
  },
  "financials_stale_days": {
   "anyOf": [
    {
     "type": "integer",
     "minimum": -9007199254740991,
     "maximum": 9007199254740991
    },
    {
     "type": "null"
    }
   ]
  },
  "data_gaps": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "confidence": {
   "type": "number",
   "minimum": 0,
   "maximum": 1
  },
  "notes_tr": {
   "type": "string"
  },
  "abstain": {
   "anyOf": [
    {
     "type": "object",
     "properties": {
      "reason": {
       "type": "string",
       "enum": [
        "insufficient_text",
        "ambiguous",
        "out_of_scope",
        "conflicting_values",
        "suspected_injection",
        "attachment_missing",
        "other"
       ]
      },
      "detail_tr": {
       "type": "string"
      }
     },
     "required": [
      "reason",
      "detail_tr"
     ],
     "additionalProperties": false
    },
    {
     "type": "null"
    }
   ]
  }
 },
 "required": [
  "status",
  "event_type",
  "denominator_kind",
  "denominator",
  "revenue_available_at_as_of",
  "market_cap",
  "fx_rates",
  "trade_day_close",
  "secondary",
  "e4_lines",
  "financials_period_end",
  "financials_stale_days",
  "data_gaps",
  "confidence",
  "notes_tr",
  "abstain"
 ],
 "additionalProperties": false
}
