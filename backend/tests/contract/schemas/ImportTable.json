{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "file_kind": {
   "type": "string",
   "enum": [
    "csv",
    "xlsx",
    "pdf"
   ]
  },
  "number_style": {
   "type": "string",
   "enum": [
    "auto",
    "dot"
   ]
  },
  "columns": {
   "type": "integer",
   "minimum": -9007199254740991,
   "maximum": 9007199254740991
  },
  "rows": {
   "type": "array",
   "items": {
    "type": "array",
    "items": {
     "type": "string"
    }
   }
  },
  "truncated": {
   "type": "boolean"
  },
  "has_header_guess": {
   "type": "boolean"
  },
  "saved_mapping": {
   "anyOf": [
    {
     "type": "object",
     "properties": {
      "has_header": {
       "type": "boolean"
      },
      "date": {
       "anyOf": [
        {
         "type": "integer",
         "minimum": 0,
         "exclusiveMaximum": 30
        },
        {
         "type": "null"
        }
       ]
      },
      "type": {
       "anyOf": [
        {
         "type": "integer",
         "minimum": 0,
         "exclusiveMaximum": 30
        },
        {
         "type": "null"
        }
       ]
      },
      "fixed_kind": {
       "anyOf": [
        {
         "type": "string",
         "enum": [
          "buy",
          "sell",
          "deposit",
          "withdrawal",
          "dividend"
         ]
        },
        {
         "type": "null"
        }
       ]
      },
      "ticker": {
       "anyOf": [
        {
         "type": "integer",
         "minimum": 0,
         "exclusiveMaximum": 30
        },
        {
         "type": "null"
        }
       ]
      },
      "qty": {
       "anyOf": [
        {
         "type": "integer",
         "minimum": 0,
         "exclusiveMaximum": 30
        },
        {
         "type": "null"
        }
       ]
      },
      "price": {
       "anyOf": [
        {
         "type": "integer",
         "minimum": 0,
         "exclusiveMaximum": 30
        },
        {
         "type": "null"
        }
       ]
      },
      "commission": {
       "anyOf": [
        {
         "type": "integer",
         "minimum": 0,
         "exclusiveMaximum": 30
        },
        {
         "type": "null"
        }
       ]
      },
      "amount": {
       "anyOf": [
        {
         "type": "integer",
         "minimum": 0,
         "exclusiveMaximum": 30
        },
        {
         "type": "null"
        }
       ]
      },
      "types": {
       "default": {},
       "type": "object",
       "propertyNames": {
        "type": "string",
        "maxLength": 60
       },
       "additionalProperties": {
        "type": "string",
        "enum": [
         "buy",
         "sell",
         "deposit",
         "withdrawal",
         "dividend",
         "skip"
        ]
       }
      }
     },
     "required": [
      "has_header",
      "types"
     ],
     "additionalProperties": false
    },
    {
     "type": "null"
    }
   ]
  },
  "saved_matches": {
   "type": "boolean"
  }
 },
 "required": [
  "file_kind",
  "number_style",
  "columns",
  "rows",
  "truncated",
  "has_header_guess",
  "saved_mapping",
  "saved_matches"
 ],
 "additionalProperties": false
}
