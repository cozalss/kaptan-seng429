{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "items": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "seq": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
     },
     "chain_pos": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
     },
     "occurred_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
     },
     "actor": {
      "type": "string",
      "pattern": "^(user|agent|system):[^\\s]+$"
     },
     "action": {
      "type": "string",
      "pattern": "^[a-z_]+\\.[a-z_.]+$"
     },
     "entity_type": {
      "type": "string"
     },
     "entity_id": {
      "type": "string"
     },
     "run_id": {
      "type": [
       "string",
       "null"
      ]
     },
     "strategy_version": {
      "type": [
       "string",
       "null"
      ]
     },
     "payload": {
      "type": "object",
      "propertyNames": {
       "type": "string"
      },
      "additionalProperties": {}
     },
     "prev_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{2}$|^[0-9a-f]{64}$"
     },
     "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
     }
    },
    "required": [
     "seq",
     "chain_pos",
     "occurred_at",
     "actor",
     "action",
     "entity_type",
     "entity_id",
     "run_id",
     "strategy_version",
     "payload",
     "prev_hash",
     "hash"
    ],
    "additionalProperties": false
   }
  },
  "total": {
   "type": "integer",
   "minimum": 0,
   "maximum": 9007199254740991
  },
  "length": {
   "type": "integer",
   "minimum": 0,
   "maximum": 9007199254740991
  },
  "tamper_on": {
   "type": "boolean"
  }
 },
 "required": [
  "items",
  "total",
  "length",
  "tamper_on"
 ],
 "additionalProperties": false
}
