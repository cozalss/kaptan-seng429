{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "disclosure_index": {
   "type": "integer",
   "exclusiveMinimum": 0,
   "maximum": 9007199254740991
  },
  "disclosure_oid": {
   "type": "string"
  },
  "stock_codes": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^[A-Z0-9]{3,6}$"
   }
  },
  "related_stocks": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^[A-Z0-9]{3,6}$"
   }
  },
  "primary_ticker": {
   "anyOf": [
    {
     "type": "string",
     "pattern": "^[A-Z0-9]{3,6}$"
    },
    {
     "type": "null"
    }
   ]
  },
  "company_name": {
   "type": "string"
  },
  "disclosure_class": {
   "type": "string",
   "enum": [
    "ODA",
    "FR",
    "DG",
    "DKB",
    "DUY"
   ]
  },
  "disclosure_type": {
   "type": "string"
  },
  "subject": {
   "type": "string"
  },
  "summary": {
   "type": "string"
  },
  "reason": {
   "type": "string",
   "enum": [
    "NEW",
    "UPD",
    "CORR",
    "CANC"
   ]
  },
  "related_index": {
   "anyOf": [
    {
     "type": "integer",
     "exclusiveMinimum": 0,
     "maximum": 9007199254740991
    },
    {
     "type": "null"
    }
   ]
  },
  "is_late": {
   "type": "boolean"
  },
  "attachment_count": {
   "type": "integer",
   "minimum": 0,
   "maximum": 9007199254740991
  },
  "has_multilang": {
   "type": "boolean"
  },
  "is_noise": {
   "type": "boolean"
  },
  "subject_route": {
   "anyOf": [
    {
     "type": "string",
     "enum": [
      "noise",
      "E1",
      "E2",
      "E3",
      "E4",
      "llm",
      "archive_only"
     ]
    },
    {
     "type": "string",
     "pattern": "^avoid:[a-z_]+$"
    }
   ]
  },
  "subject_map_version": {
   "type": "string"
  },
  "published_at": {
   "type": "string",
   "format": "date-time",
   "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
  },
  "first_seen_at": {
   "type": "string",
   "format": "date-time",
   "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
  },
  "available_at": {
   "type": "string",
   "format": "date-time",
   "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
  },
  "ingest_source": {
   "type": "string",
   "enum": [
    "live",
    "backfill",
    "reconcile",
    "demo"
   ]
  },
  "classification": {
   "anyOf": [
    {
     "type": "object",
     "properties": {
      "event_type": {
       "type": "string",
       "enum": [
        "E1",
        "E2",
        "E3",
        "E4",
        "FILTER",
        "IGNORE"
       ]
      },
      "confidence": {
       "type": "number",
       "minimum": 0,
       "maximum": 1
      },
      "method": {
       "type": "string",
       "enum": [
        "subject_map",
        "llm"
       ]
      }
     },
     "required": [
      "event_type",
      "confidence",
      "method"
     ],
     "additionalProperties": false
    },
    {
     "type": "null"
    }
   ]
  },
  "run_id": {
   "type": [
    "string",
    "null"
   ]
  },
  "linked_news_count": {
   "type": "integer",
   "minimum": 0,
   "maximum": 9007199254740991
  },
  "note_count": {
   "type": "integer",
   "minimum": 0,
   "maximum": 9007199254740991
  },
  "texts": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "lang": {
      "type": "string",
      "enum": [
       "tr",
       "en"
      ]
     },
     "body": {
      "type": "string"
     }
    },
    "required": [
     "lang",
     "body"
    ],
    "additionalProperties": false
   }
  },
  "notes": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "disclosure_index": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
     },
     "author": {
      "type": "string"
     },
     "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
     },
     "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
     }
    },
    "required": [
     "id",
     "disclosure_index",
     "author",
     "body",
     "created_at"
    ],
    "additionalProperties": false
   }
  }
 },
 "required": [
  "disclosure_index",
  "disclosure_oid",
  "stock_codes",
  "related_stocks",
  "primary_ticker",
  "company_name",
  "disclosure_class",
  "disclosure_type",
  "subject",
  "summary",
  "reason",
  "related_index",
  "is_late",
  "attachment_count",
  "has_multilang",
  "is_noise",
  "subject_route",
  "subject_map_version",
  "published_at",
  "first_seen_at",
  "available_at",
  "ingest_source",
  "classification",
  "run_id",
  "linked_news_count",
  "note_count",
  "texts",
  "notes"
 ],
 "additionalProperties": false
}
