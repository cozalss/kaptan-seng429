{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "passphrase": {
   "type": "string",
   "maxLength": 200
  },
  "next": {
   "anyOf": [
    {
     "type": "string",
     "maxLength": 500
    },
    {
     "type": "null"
    }
   ]
  },
  "role": {
   "type": "string",
   "enum": [
    "analyst",
    "risk_officer",
    "admin",
    "auditor"
   ]
  }
 },
 "required": [
  "passphrase"
 ],
 "additionalProperties": false
}
