{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "ticker": {
   "type": "string",
   "pattern": "^[A-Z0-9]{3,6}$"
  },
  "net_try": {
   "type": "number",
   "exclusiveMinimum": 0,
   "maximum": 10000000000
  },
  "gross_try": {
   "anyOf": [
    {
     "type": "number",
     "exclusiveMinimum": 0,
     "maximum": 10000000000
    },
    {
     "type": "null"
    }
   ]
  },
  "received_on": {
   "type": "string",
   "format": "date",
   "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
  },
  "note": {
   "default": "",
   "type": "string",
   "maxLength": 200
  },
  "notice_id": {
   "anyOf": [
    {
     "type": "string",
     "maxLength": 60
    },
    {
     "type": "null"
    }
   ]
  }
 },
 "required": [
  "ticker",
  "net_try",
  "received_on",
  "note"
 ],
 "additionalProperties": false
}
