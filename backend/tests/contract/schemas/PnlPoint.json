{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "d": {
   "type": "string",
   "format": "date",
   "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
  },
  "strategy": {
   "anyOf": [
    {
     "type": "string",
     "enum": [
      "kaptan:v1.0-fwd",
      "kaptan:v1.1-fwd",
      "baseline:xu100_bh",
      "baseline:ew_universe"
     ]
    },
    {
     "type": "string",
     "pattern": "^ablation:[a-z0-9_]+$"
    }
   ]
  },
  "equity": {
   "type": "number"
  },
  "daily_return": {
   "type": "number"
  },
  "peak_equity": {
   "type": "number"
  },
  "drawdown": {
   "type": "number",
   "maximum": 0
  },
  "n_positions": {
   "type": "integer",
   "minimum": 0,
   "maximum": 9007199254740991
  },
  "n_trades": {
   "type": "integer",
   "minimum": 0,
   "maximum": 9007199254740991
  }
 },
 "required": [
  "d",
  "strategy",
  "equity",
  "daily_return",
  "peak_equity",
  "drawdown",
  "n_positions",
  "n_trades"
 ],
 "additionalProperties": false
}
