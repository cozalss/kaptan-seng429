{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "day": {
   "type": "string",
   "format": "date",
   "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
  },
  "is_trading_day": {
   "type": "boolean"
  },
  "note": {
   "type": [
    "string",
    "null"
   ]
  },
  "prev_day": {
   "type": "string",
   "format": "date",
   "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
  },
  "next_day": {
   "anyOf": [
    {
     "type": "string",
     "format": "date",
     "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    {
     "type": "null"
    }
   ]
  },
  "total": {
   "type": "integer",
   "minimum": 0,
   "maximum": 9007199254740991
  },
  "truncated": {
   "type": "boolean"
  },
  "kinds": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "kind": {
      "type": "string",
      "enum": [
       "restriction",
       "insider",
       "contract",
       "earnings",
       "dividend",
       "capital",
       "merger",
       "buyback"
      ]
     },
     "title": {
      "type": "string"
     },
     "count": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
     }
    },
    "required": [
     "kind",
     "title",
     "count"
    ],
    "additionalProperties": false
   }
  },
  "items": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "disclosure_index": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
     },
     "kind": {
      "type": "string",
      "enum": [
       "restriction",
       "insider",
       "contract",
       "earnings",
       "dividend",
       "capital",
       "merger",
       "buyback"
      ]
     },
     "ticker": {
      "type": "string",
      "pattern": "^[A-Z0-9]{3,6}$"
     },
     "company_name": {
      "type": "string"
     },
     "line": {
      "type": "string"
     },
     "headline": {
      "type": [
       "string",
       "null"
      ]
     },
     "published_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
     },
     "source_url": {
      "type": "string",
      "format": "uri"
     },
     "why": {
      "anyOf": [
       {
        "type": "string",
        "enum": [
         "held",
         "watched"
        ]
       },
       {
        "type": "null"
       }
      ]
     },
     "outside_list": {
      "type": "boolean"
     },
     "outside_note": {
      "type": [
       "string",
       "null"
      ]
     },
     "tone": {
      "type": "string",
      "enum": [
       "olumlu",
       "olumsuz",
       "notr",
       "belirsiz"
      ]
     },
     "so_what_tr": {
      "type": [
       "string",
       "null"
      ]
     },
     "suggestion_tr": {
      "type": [
       "string",
       "null"
      ]
     },
     "panel_path": {
      "type": "string"
     }
    },
    "required": [
     "disclosure_index",
     "kind",
     "ticker",
     "company_name",
     "line",
     "headline",
     "published_at",
     "source_url",
     "why",
     "outside_list",
     "outside_note",
     "tone",
     "so_what_tr",
     "suggestion_tr",
     "panel_path"
    ],
    "additionalProperties": false
   }
  }
 },
 "required": [
  "day",
  "is_trading_day",
  "note",
  "prev_day",
  "next_day",
  "total",
  "truncated",
  "kinds",
  "items"
 ],
 "additionalProperties": false
}
