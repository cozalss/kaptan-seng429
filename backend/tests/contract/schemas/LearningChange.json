{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "version": {
   "type": "integer",
   "minimum": 1,
   "maximum": 9007199254740991
  },
  "rule": {
   "type": "string"
  },
  "label_tr": {
   "type": "string"
  },
  "unit": {
   "type": "string",
   "enum": [
    "pct",
    "try"
   ]
  },
  "from_value": {
   "type": "number"
  },
  "to_value": {
   "type": "number"
  },
  "at": {
   "type": "string",
   "format": "date-time",
   "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
  },
  "status": {
   "type": "string",
   "enum": [
    "applied",
    "proposed",
    "reverted"
   ]
  },
  "reason_tr": {
   "type": "string"
  },
  "gain_bps": {
   "type": "number"
  },
  "ci_low_bps": {
   "type": "number"
  },
  "ci_high_bps": {
   "type": "number"
  },
  "n": {
   "type": "integer",
   "minimum": 0,
   "maximum": 9007199254740991
  },
  "can_revert": {
   "type": "boolean"
  }
 },
 "required": [
  "version",
  "rule",
  "label_tr",
  "unit",
  "from_value",
  "to_value",
  "at",
  "status",
  "reason_tr",
  "gain_bps",
  "ci_low_bps",
  "ci_high_bps",
  "n",
  "can_revert"
 ],
 "additionalProperties": false
}
