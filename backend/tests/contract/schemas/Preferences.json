{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "pause": {
   "type": "object",
   "properties": {
    "active": {
     "type": "boolean"
    },
    "until": {
     "anyOf": [
      {
       "type": "string",
       "format": "date-time",
       "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
      },
      {
       "type": "null"
      }
     ]
    },
    "since": {
     "anyOf": [
      {
       "type": "string",
       "format": "date-time",
       "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
      },
      {
       "type": "null"
      }
     ]
    }
   },
   "required": [
    "active",
    "until",
    "since"
   ],
   "additionalProperties": false
  },
  "alerts": {
   "type": "object",
   "properties": {
    "kinds": {
     "type": "object",
     "properties": {
      "suggestion": {
       "type": "object",
       "properties": {
        "phone": {
         "type": "boolean"
        },
        "desktop": {
         "type": "boolean"
        }
       },
       "required": [
        "phone",
        "desktop"
       ],
       "additionalProperties": false
      },
      "day_halt": {
       "type": "object",
       "properties": {
        "phone": {
         "type": "boolean"
        },
        "desktop": {
         "type": "boolean"
        }
       },
       "required": [
        "phone",
        "desktop"
       ],
       "additionalProperties": false
      },
      "stopped": {
       "type": "object",
       "properties": {
        "phone": {
         "type": "boolean"
        },
        "desktop": {
         "type": "boolean"
        }
       },
       "required": [
        "phone",
        "desktop"
       ],
       "additionalProperties": false
      },
      "part_down": {
       "type": "object",
       "properties": {
        "phone": {
         "type": "boolean"
        },
        "desktop": {
         "type": "boolean"
        }
       },
       "required": [
        "phone",
        "desktop"
       ],
       "additionalProperties": false
      },
      "watched": {
       "type": "object",
       "properties": {
        "phone": {
         "type": "boolean"
        },
        "desktop": {
         "type": "boolean"
        }
       },
       "required": [
        "phone",
        "desktop"
       ],
       "additionalProperties": false
      }
     },
     "required": [
      "suggestion",
      "day_halt",
      "stopped",
      "part_down",
      "watched"
     ],
     "additionalProperties": false
    },
    "quiet": {
     "type": "object",
     "properties": {
      "on": {
       "type": "boolean"
      },
      "start": {
       "type": "string",
       "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
      },
      "end": {
       "type": "string",
       "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
      }
     },
     "required": [
      "on",
      "start",
      "end"
     ],
     "additionalProperties": false
    }
   },
   "required": [
    "kinds",
    "quiet"
   ],
   "additionalProperties": false
  }
 },
 "required": [
  "pause",
  "alerts"
 ],
 "additionalProperties": false
}
