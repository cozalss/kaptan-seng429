{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "selection": {
   "type": "object",
   "properties": {
    "status": {
     "type": "string",
     "enum": [
      "ok",
      "abstain"
     ]
    },
    "event_type": {
     "type": "string",
     "enum": [
      "E1",
      "E2",
      "E3",
      "E4"
     ]
    },
    "search_queries": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "candidates_considered": {
     "type": "integer",
     "minimum": 0,
     "maximum": 9007199254740991
    },
    "selected": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "ref_id": {
        "type": "string",
        "pattern": "^evt:"
       },
       "relevance": {
        "type": "string",
        "enum": [
         "high",
         "medium"
        ]
       },
       "why_similar_tr": {
        "type": "string"
       }
      },
      "required": [
       "ref_id",
       "relevance",
       "why_similar_tr"
      ],
      "additionalProperties": false
     }
    },
    "same_ticker_selected": {
     "type": "integer",
     "minimum": 0,
     "maximum": 9007199254740991
    },
    "exclusion_reasons": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "already_announced_before": {
     "type": "boolean"
    },
    "already_announced_ref": {
     "type": [
      "string",
      "null"
     ]
    },
    "proposed_strength": {
     "type": "string",
     "enum": [
      "strong",
      "moderate",
      "weak",
      "insufficient"
     ]
    },
    "summary_tr": {
     "type": "string"
    },
    "confidence": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "abstain": {
     "anyOf": [
      {
       "type": "object",
       "properties": {
        "reason": {
         "type": "string",
         "enum": [
          "insufficient_text",
          "ambiguous",
          "out_of_scope",
          "conflicting_values",
          "suspected_injection",
          "attachment_missing",
          "other"
         ]
        },
        "detail_tr": {
         "type": "string"
        }
       },
       "required": [
        "reason",
        "detail_tr"
       ],
       "additionalProperties": false
      },
      {
       "type": "null"
      }
     ]
    }
   },
   "required": [
    "status",
    "event_type",
    "search_queries",
    "candidates_considered",
    "selected",
    "same_ticker_selected",
    "exclusion_reasons",
    "already_announced_before",
    "already_announced_ref",
    "proposed_strength",
    "summary_tr",
    "confidence",
    "abstain"
   ],
   "additionalProperties": false
  },
  "stats": {
   "type": "object",
   "properties": {
    "ref_id": {
     "type": "string"
    },
    "n": {
     "type": "integer",
     "minimum": 0,
     "maximum": 9007199254740991
    },
    "n_same_ticker": {
     "type": "integer",
     "minimum": 0,
     "maximum": 9007199254740991
    },
    "median_car_5d": {
     "type": "number"
    },
    "mean_car_5d": {
     "type": "number"
    },
    "hit_rate_5d": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "median_car_20d": {
     "type": "number"
    },
    "mean_car_20d": {
     "type": "number"
    },
    "hit_rate_20d": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "ci95_car_20d": {
     "type": "array",
     "prefixItems": [
      {
       "type": "number"
      },
      {
       "type": "number"
      }
     ],
     "items": false,
     "minItems": 2,
     "maxItems": 2
    },
    "dispersion_iqr_20d": {
     "type": "number",
     "minimum": 0
    }
   },
   "required": [
    "ref_id",
    "n",
    "n_same_ticker",
    "median_car_5d",
    "mean_car_5d",
    "hit_rate_5d",
    "median_car_20d",
    "mean_car_20d",
    "hit_rate_20d",
    "ci95_car_20d",
    "dispersion_iqr_20d"
   ],
   "additionalProperties": false
  },
  "strength": {
   "type": "string",
   "enum": [
    "strong",
    "moderate",
    "weak",
    "insufficient"
   ]
  },
  "retrieved_ids": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "card_id": {
   "type": "string"
  }
 },
 "required": [
  "selection",
  "stats",
  "strength",
  "retrieved_ids",
  "card_id"
 ],
 "additionalProperties": false
}
