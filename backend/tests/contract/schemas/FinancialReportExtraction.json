{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "status": {
   "type": "string",
   "enum": [
    "ok",
    "abstain"
   ]
  },
  "confidence": {
   "type": "number",
   "minimum": 0,
   "maximum": 1
  },
  "injection_suspected": {
   "type": "boolean"
  },
  "quotes": {
   "minItems": 1,
   "maxItems": 8,
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "field": {
      "type": "string"
     },
     "quote": {
      "type": "string",
      "minLength": 1
     }
    },
    "required": [
     "field",
     "quote"
    ],
    "additionalProperties": false
   }
  },
  "notes_tr": {
   "type": "string"
  },
  "abstain": {
   "anyOf": [
    {
     "type": "object",
     "properties": {
      "reason": {
       "type": "string",
       "enum": [
        "insufficient_text",
        "ambiguous",
        "out_of_scope",
        "conflicting_values",
        "suspected_injection",
        "attachment_missing",
        "other"
       ]
      },
      "detail_tr": {
       "type": "string"
      }
     },
     "required": [
      "reason",
      "detail_tr"
     ],
     "additionalProperties": false
    },
    {
     "type": "null"
    }
   ]
  },
  "kind": {
   "type": "string",
   "const": "E4"
  },
  "period": {
   "type": "string",
   "pattern": "^\\d{4}-(Q[1-4]|H1|9M|FY)$"
  },
  "report_kind": {
   "type": "string"
  },
  "consolidated": {
   "type": "boolean"
  },
  "tms29_applied": {
   "type": "boolean"
  },
  "audit_opinion": {
   "type": [
    "string",
    "null"
   ]
  },
  "going_concern_emphasis": {
   "type": "boolean"
  },
  "guidance_direction": {
   "type": "string",
   "enum": [
    "up",
    "down",
    "flat",
    "none"
   ]
  },
  "guidance_statements_tr": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "one_off_items": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "management_tone": {
   "type": "string",
   "enum": [
    "positive",
    "neutral",
    "negative",
    "mixed"
   ]
  },
  "risk_mentions_tr": {
   "type": "array",
   "items": {
    "type": "string"
   }
  }
 },
 "required": [
  "status",
  "confidence",
  "injection_suspected",
  "quotes",
  "notes_tr",
  "abstain",
  "kind",
  "period",
  "report_kind",
  "consolidated",
  "tms29_applied",
  "audit_opinion",
  "going_concern_emphasis",
  "guidance_direction",
  "guidance_statements_tr",
  "one_off_items",
  "management_tone",
  "risk_mentions_tr"
 ],
 "additionalProperties": false
}
