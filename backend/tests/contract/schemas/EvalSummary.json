     "max_dd": {
      "type": "number"
     },
     "total_return": {
      "type": "number"
     },
     "n_trades": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
     }
    },
    "required": [
     "arm",
     "label_tr",
     "sharpe",
     "max_dd",
     "total_return",
     "n_trades"
    ],
    "additionalProperties": false
   }
  },
  "redteam": {
   "type": "object",
   "properties": {
    "malicious": {
     "type": "integer",
