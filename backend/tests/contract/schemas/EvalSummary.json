     "minimum": -9007199254740991,
     "maximum": 9007199254740991
    },
    "tokens_per_decision": {
     "type": "integer",
     "minimum": -9007199254740991,
     "maximum": 9007199254740991
    }
   },
   "required": [
    "calls_today",
    "tokens_today",
    "tokens_per_decision"
   ],
   "additionalProperties": false
