{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "id": {
   "type": "string"
  },
  "ticker": {
   "type": "string"
  },
  "name": {
   "type": "string"
  },
  "direction": {
   "type": "string",
   "enum": [
    "above",
    "below"
   ]
  },
  "level": {
   "type": "number",
   "exclusiveMinimum": 0
  },
  "preset_pct": {
   "anyOf": [
    {
     "anyOf": [
      {
       "type": "number",
       "const": 5
      },
      {
       "type": "number",
       "const": 10
      }
     ]
    },
    {
     "type": "null"
    }
   ]
  },
  "created_at": {
   "type": "string",
   "format": "date-time",
   "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
  },
  "triggered_at": {
   "anyOf": [
    {
     "type": "string",
     "format": "date-time",
     "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    {
     "type": "null"
    }
   ]
  },
  "triggered_price": {
   "type": [
    "number",
    "null"
   ]
  },
  "current_price": {
   "type": [
    "number",
    "null"
   ]
  },
  "current_at": {
   "anyOf": [
    {
     "type": "string",
     "format": "date-time",
     "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    {
     "type": "null"
    }
   ]
  }
 },
 "required": [
  "id",
  "ticker",
  "name",
  "direction",
  "level",
  "preset_pct",
  "created_at",
  "triggered_at",
  "triggered_price",
  "current_price",
  "current_at"
 ],
 "additionalProperties": false
}
