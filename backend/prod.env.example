# docker-compose.prod.yml values. Copy to prod.env (gitignored: *.env) and fill in; never commit it.
#   docker compose -f docker-compose.prod.yml --env-file prod.env up -d --build
# Every variable the backend reads (src/kaptan/settings.py + a few os.environ reads) is listed here.
# Only the REQUIRED block must be filled; everything else is commented out at the code's default.
# Passwords go into URLs: use hex (openssl rand -hex 24), no @ : / % characters.

# ── REQUIRED ────────────────────────────────────────────────────────────────
POSTGRES_DB=kaptan
POSTGRES_PASSWORD=<openssl rand -hex 24>
KAPTAN_APP_PASSWORD=<openssl rand -hex 24>
REDIS_PASSWORD=<openssl rand -hex 24>
# >= 32 random bytes: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=<random>
# uv run python scripts/hash_passphrase.py — keep the single quotes: the hash contains $ signs.
PASSPHRASE_HASH='<argon2id hash>'
# The panel's origin(s), comma separated.
ALLOWED_ORIGINS=https://panel.example.org

# Set by the compose file itself (not read from here): KAPTAN_ENV=prod, DATABASE_URL, DATABASE_OWNER_URL
# (migrate/bootstrap only), REDIS_URL, COOKIE_SECURE=true, DEMO_MODE=false, LOG_FORMAT=json, TZ=UTC,
# BOOTSTRAP_ADMIN_URL (db-roles), KAPTAN_HOST/KAPTAN_PORT (image: 0.0.0.0:8000).

# ── Host / compose ──────────────────────────────────────────────────────────
# API_PORT=8000                       # published on 127.0.0.1 only
# KAPTAN_IMAGE=kaptan-backend:local
# BACKUP_HOST_DIR=./backups
# BACKUP_KEEP_DAYS=14
# AGE_RECIPIENTS=age1...              # public keys only; backups are encrypted to them
# WEB_CONCURRENCY=1                   # uvicorn workers of the API
# GIT_SHA=                            # stamped into eval manifests (else "dev")

# ── LLM (replay = recorded answers, no keys; live = real providers) ─────────
# LLM_MODE=live
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# GROQ_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=<deployment name>
# AZURE_OPENAI_API_VERSION=2024-10-21
# OLLAMA_BASE_URL=http://<host>:11434/v1
# Daily caps per UTC day (over a cap = provider skipped)
# LLM_CAP_GEMINI_RPD=400
# LLM_CAP_GROQ_RPD=900
# LLM_CAP_GROQ_TPD=180000
# LLM_CAP_GUARD_RPD=14000
# LLM_CAP_DEEPSEEK_RPD=200
# LLM_CAP_DEEPSEEK_USD=0.50
# LLM_CAP_AZURE_RPD=300
# LLM_CACHE_TTL_S=2592000
# CHECKPOINTER=postgres               # compose default; memory loses parked runs on restart
# AGENT_MAX_RUNS_PER_HOUR=6
# AGENT_MAX_RUNS_PER_DAY=0          # agent runs that reach an LLM per Istanbul day; 0 = no daily cap

# ── KAP ingestion and prices ────────────────────────────────────────────────
# KAP_LIVE=true                       # the ingest/agent workers exit 0 without it
# KAP_POLL_SESSION_S=30               # never below 30
# KAP_POLL_OFFHOURS_S=60
# KAP_POLL_NIGHT_S=300
# KAP_MIN_INTERVAL_S=2
# KAP_TIMEOUT_S=60
# KAP_MAX_RETRIES=4
# KAP_FETCH_DETAILS=true
# PRICES_LIVE=true
# PRICES_MIN_INTERVAL_S=2
# QUOTE_DELAY_S=900
# TEDBIR_BULLETIN_URL=                # an SPK bulletin PDF URL; empty = off
# AUDIT_ANCHOR_FILE=                  # a path on a mounted writable volume (rootfs is read-only); empty = off
# JOB_RUNS_KEEP_DAYS=90

# ── RAG ─────────────────────────────────────────────────────────────────────
# RAG_EMBEDDER=gemini                 # gemini | fake
# RAG_CONTEXT_K=5
# RAG_REGULATION_K=3
# RAG_INDEX_ON_INGEST=false
# RAG_EMBED_CAP_RPD=500
# RAG_EMBED_CAP_TPD=1500000
# RAG_EMBED_BATCH=16
# RAG_EMBED_MIN_INTERVAL_S=1

# ── Desk ────────────────────────────────────────────────────────────────────
# KAPTAN_MODE=paper                   # paper | personal | live | backtest
# KAPTAN_LIVE_ENABLED=false           # K2 of the three live keys; orders still go to SimBIST without a broker adapter
# PAPER_CAPITAL_TRY=1000000
# PERSONAL_ACCOUNT_TRY=350000

# ── Auth, limits, ops ───────────────────────────────────────────────────────
# JWT_ISSUER=kaptan
# JWT_AUDIENCE=kaptan-web
# ACCESS_TOKEN_TTL_S=900
# REFRESH_TOKEN_TTL_S=28800
# REFRESH_GRACE_S=10
# LOGIN_RATE_PER_MINUTE=5
# MUTATION_RATE_PER_MINUTE=60
# RATE_LIMIT_BACKEND=auto             # auto | memory | redis
# TRUSTED_PROXIES=172.16.0.0/12
# METRICS_TOKEN=<random>
# DB_POOL_MIN=1
# DB_POOL_MAX=10
# LOG_LEVEL=INFO
# HSTS_MAX_AGE_S=31536000

# ── One-off jobs (pass with `run -e`, not kept here) ────────────────────────
# KAPTAN_BOOTSTRAP_USERS='{"users":[...]}'   # bootstrap: JSON team override (password_env per person)
# KAPTAN_OWNER_PASSWORD=                     # bootstrap roles --rotate: new kaptan_owner password
# RESTORE_DATABASE_URL=                      # ops/restore.sh and `python -m kaptan.ops.backup verify`
# KAPTAN_COMPONENT=                          # healthcheck override (api | ingest_worker | agent_worker | scheduler)

# Not used in prod (dev/test only, code defaults): TEST_DATABASE_URL, TEST_DATABASE_OWNER_URL,
# DEMO_LIVE_TICKER, KAP_BASE_URL, KAP_USER_AGENT, KAPTAN_RAGAS, KAPTAN_LLM_RECORD.
