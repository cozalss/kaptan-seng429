# docker-compose.prod.yml values. Copy to prod.env (gitignored: *.env) and fill in; never commit it.
# Passwords go into URLs: use hex (openssl rand -hex 24), no @ : / % characters.
POSTGRES_DB=kaptan
POSTGRES_PASSWORD=<openssl rand -hex 24>
KAPTAN_APP_PASSWORD=<openssl rand -hex 24>
REDIS_PASSWORD=<openssl rand -hex 24>
# >= 32 random bytes: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=<random>
# uv run python scripts/hash_passphrase.py — keep the single quotes: the hash contains $ signs.
PASSPHRASE_HASH='<argon2id hash>'
# The panel's origin(s), comma separated.
ALLOWED_ORIGINS=https://panel.example.org
# Optional
# LLM_MODE=live
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# GROQ_API_KEY=
# KAP_LIVE=true
# TRUSTED_PROXIES=172.16.0.0/12
# METRICS_TOKEN=<random>
# API_PORT=8000
# AGE_RECIPIENTS=age1...
