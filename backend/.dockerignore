# Everything not needed at run time, and every secret, stays out of the build context.
**/.env
**/.env.*
!.env.example
*.env
**/*.pem
**/*.key
secrets/
.venv/
**/__pycache__/
**/*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
backups/
ops/
scripts/
docs/
*.md
tests/*
!tests/__init__.py
!tests/fixtures/
tests/fixtures/*
!tests/fixtures/demo/
# The demo seed (kaptan.demo.fixtures) reads these three; the rest of expected/ is test-only.
tests/fixtures/demo/expected/*
!tests/fixtures/demo/expected/orders.json
!tests/fixtures/demo/expected/tickets.json
!tests/fixtures/demo/expected/positions.json
Dockerfile
docker-compose*.yml
