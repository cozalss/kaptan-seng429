# KAPtan live mode: today's real KAP disclosures, real (≈15 min delayed / end-of-day) Borsa İstanbul prices,
# the real clock and the live LLM agents. From the repo root:
#
#   docker compose down                                          # stop the replay stack (keeps its data)
#   docker compose --env-file live.env --profile live up -d --build
#   docker compose --env-file live.env logs -f warmup            # first start: ~15-25 min of polite loading
#
# Back to the recorded day: `docker compose --env-file live.env --profile live down` then `docker compose up -d`.
# LLM keys: GEMINI_API_KEY / DEEPSEEK_API_KEY / GROQ_API_KEY in backend/.env (never in this file).
# No secrets here: this file is safe to commit.

DEMO_MODE=false
LLM_MODE=live
KAP_LIVE=true
PRICES_LIVE=true
CHECKPOINTER=postgres

# Own database + Redis volumes: the recorded day's volumes (pgdata, redisdata) stay as they are.
KAPTAN_PGDATA=pgdata_live
KAPTAN_REDISDATA=redisdata_live

# Spend guardrails: the R03/R04/R13 pre-gate (no LLM) screens first; then at most this many runs reach a
# model per hour / per Istanbul day. Provider caps (LLM_CAP_*_RPD, DeepSeek $0.50/day) still apply.
AGENT_MAX_RUNS_PER_HOUR=4
AGENT_MAX_RUNS_PER_DAY=20

# First start: KAP history days before today and the most shares whose price history is loaded.
LIVE_BACKFILL_DAYS=5
LIVE_WARMUP_MAX_TICKERS=300
