# KAPtan: settings that are not secret. Committed, and read at every start (docker-compose.yml, env_file).
# Secrets are not here: they are in .env, which kur.ps1 writes and git ignores. Never put a key in this file.
# Any other setting of backend/src/kaptan/settings.py can be added here; docker-compose.yml's `environment`
# block fixes the ones that define the system (live data, production checks) and those win.

# Spend guardrails: the R03/R04/R13 pre-gate (no LLM) screens first; then at most this many runs reach a
# model per hour / per Istanbul day. Provider caps (LLM_CAP_*_RPD, DeepSeek $0.50/day) still apply.
AGENT_MAX_RUNS_PER_HOUR=25
AGENT_MAX_RUNS_PER_DAY=70

# Warm-up: KAP history days before today and the most shares whose price history is loaded.
LIVE_BACKFILL_DAYS=5
LIVE_WARMUP_MAX_TICKERS=300
