# What .\kur.ps1 writes to .env (gitignored). You do not need to copy this by hand: run .\kur.ps1.
# Every value below is filled in by it; with any of the first group empty, docker compose refuses to start.

# Secrets, generated once and kept on every re-run
JWT_SECRET=
POSTGRES_PASSWORD=
KAPTAN_APP_PASSWORD=
REDIS_PASSWORD=

# argon2 hash of the password you choose. Only the hash is stored. In single quotes: it contains $.
PASSPHRASE_HASH=

# Provider keys, at least one. Gemini is also what fills the "similar past disclosures" memory.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=

# The Windows folder for nightly backups and the audit anchor, with forward slashes.
KAPTAN_BACKUP_DIR=

# Optional
# KAPTAN_PANEL_PORT=3100
# BACKUP_KEEP_DAYS=14
# BACKUP_HOUR=3
